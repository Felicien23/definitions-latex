\ProvidesPackage{definitions}[2026/11/23 v2.0.0 Math, unit and code-listing shortcuts]

% ---------------------------------------------------------------------
% Packages the macros need.  Load packages that take options (xcolor,
% amsmath, siunitx, ...) BEFORE \usepackage{definitions} if you want
% to pass options to them.
%
% hyperref is deliberately not loaded: it should be loaded late, by the
% document, with the document's own options.  \mail and \ftplink make
% links when hyperref is present and print plain text otherwise.
%
% bbold is deliberately not loaded either: its package replaces
% \mathbb document-wide.  \iden selects the bbold font directly, so
% only the bbold fonts need to be installed.
% ---------------------------------------------------------------------
\RequirePackage{amsmath}
\RequirePackage{amssymb}
\RequirePackage{bm}
\RequirePackage{ifthen}
\RequirePackage{xcolor}
\RequirePackage{listings}
\RequirePackage{siunitx}
\RequirePackage[version=4]{mhchem}

% ---------------------------------------------------------------------
% Load the modules from the directory that contains this file, so that
% \usepackage{<dir>/definitions} works without changing TEXINPUTS and a
% stray copy of a module next to the document is not picked up instead.
% (\CurrentFilePath is empty when the package was found through a
% TEXINPUTS or TEXMF search path; the modules are then found the same way.)
% Commandes.tex ends with \makeatother, so @ is made a letter again after
% each module.
% Order matters: operators and units first, LanguageStyle last.
% ---------------------------------------------------------------------
\edef\definitions@dir{\CurrentFilePath}% chktex 41
\ifx\definitions@dir\@empty\else % chktex 41
  \edef\definitions@dir{\definitions@dir/}% chktex 41
\fi % chktex 41
\newcommand*\definitions@load[1]{\input{\definitions@dir#1}\makeatletter}% chktex 27
\definitions@load{Operator.tex}
\definitions@load{Units.tex}
\definitions@load{Commandes.tex}
\definitions@load{LanguageStyle.tex}

\endinput
